-#}

		{% if (!blank_page): %}
		</div>

		<footer class="sl-footer">
			<div class="sl-footer-inner">
				<span class="sl-footer-meta">
					<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">
						{{ version.luciname }} ({{ version.luciversion }})</a>
					<span class="sl-sep">/</span>
					<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">
						{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</a>
					{% if (lua_active): %}
						<span class="sl-sep">/</span> {{ _('Lua compatibility mode active') }}
					{% endif %}
				</span>

				<span class="sl-footer-brand">
					<span class="sl-footer-badge" aria-hidden="true">S</span>
					<span>Alagha Technology</span>
				</span>
			</div>
		</footer>

		{#- The module name carries the release.

		    L.require() appends a ?v= of its own, but it is LuCI's build string
		    and does not move when SMARTLink is upgraded - so a browser kept the
		    script it already had. New markup against old script is not merely
		    stale, it is broken: the old one reached for #modemenu, which this
		    theme no longer renders, threw on the null, and never got as far as
		    binding the menu button or the theme toggle. Both simply stopped
		    working, with nothing on screen to say why.

		    A name that changes with the release is a URL the browser has to go
		    and fetch. The build stamps it into both this call and the filename
		    it installs. -#}
		<script type="text/javascript">L.require('menu-SMARTLINK_SLUG')</script>
		{% endif %}
	</body>
</html>
